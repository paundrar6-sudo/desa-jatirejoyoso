{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "desa-jatirejoyoso",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "desa-jatirejoyoso-db",
      "database_id": "2cdad5f6-844e-412d-bf72-5b950b808706",
      "migrations_dir": "db/migrations"
    }
  ]
}
